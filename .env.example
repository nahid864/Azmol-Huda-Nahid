# Contact form endpoint.
#
# Without this, the contact form falls back to opening the visitor's mail
# client — which only works if they have one configured. Set it to send
# submissions straight to your inbox instead.
#
# Quickest option — Formspree (free tier available):
#   1. Sign up at https://formspree.io and create a form
#   2. Copy the endpoint it gives you (looks like the line below)
#   3. Save it in a file named `.env` in this folder
#
# This value is PUBLIC (it ships in the built JS bundle). That's expected for
# Formspree — never put a private API key or secret here.

# src/components/Contact.jsx already falls back to the project's Formspree
# endpoint, so the form works on the deployed site without this. Set it only to
# route submissions somewhere else.
VITE_FORM_ENDPOINT=https://formspree.io/f/xnpqqwjb


# Résumé / CV download.
#
# Drop your PDF into `public/assets/` and put JUST THE FILENAME here. The
# "Download CV" button stays hidden until this is set, so visitors never hit a
# broken download link.
#
# Example: put public/assets/Azmol-Huda-Nahid-CV.pdf, then set:
# VITE_RESUME_URL=Azmol-Huda-Nahid-CV.pdf
#
# Note: src/config.js already falls back to Azmol_Huda_Nahid_CV_soft.pdf so the
# button works on the deployed site too. Set this only to point at a different file.

VITE_RESUME_URL=Azmol_Huda_Nahid_CV_soft.pdf


# Blog home — Medium, Dev.to, Hashnode, or your own.
#
# Until this is set, the Articles section shows the topics as "Coming soon"
# with no dead links. Set it once you actually publish, and the cards become
# real "Read more" links.
#
# Example: VITE_BLOG_URL=https://medium.com/@yourhandle

VITE_BLOG_URL=


# Public site URL — used for canonical + social share (Open Graph) tags.
# Change this if you move to a custom domain.

VITE_SITE_URL=https://nahid864.github.io/Azmol-Huda-Nahid/
